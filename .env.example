# App -------------------------------------------------------------------
# Drives canonicals, OG tags, JSON-LD and the Polar success URL.
NEXT_PUBLIC_APP_URL=https://111111.live

# Payments (Polar) ------------------------------------------------------
# The product MUST allow a dynamic / pay-what-you-want amount: checkout
# sends the band price in cents ($1 -> 100 ... $111,111 -> 11111100).
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
POLAR_SERVER=sandbox

# Webhook endpoint to register in Polar:
#   https://111111.live/api/webhook/polar

# Storage ---------------------------------------------------------------
# Board state lives in Vercel Blob. Set automatically on Vercel.
BLOB_READ_WRITE_TOKEN=

# Ops -------------------------------------------------------------------
# /admin, /api/admin/seed and /api/admin/clear
ADMIN_SECRET=change-me
# Bearer token for /api/cron/rollover. Vercel Cron is allowed through
# without it, but set one so nobody else can trigger a sweep.
CRON_SECRET=
